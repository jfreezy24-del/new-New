//@version=6
// TTrades Fractal Model (TTFM) — Recreation
// Educational recreation of the concept behind TTrades' fractal model
// (credit @TTrades; the official indicator is by @toodegrees).
//
// The model frames every setup as three higher-timeframe candles:
//   Candle 1 — sets the range (ideally at a point of interest)
//   Candle 2 — SWEEPS candle 1's high/low but CLOSES BACK INSIDE (reversal closure)
//   Candle 3 — the expansion candle you trade
// Confirmation is a lower-timeframe CISD (Change In State of Delivery): after
// the sweep, price closes through the OPEN of the consecutive same-direction
// candle series that made the extreme. HTF closure + LTF CISD = entry,
// targeting candle 1's opposite side.
//
// Simplification vs the full model: the "point of interest" requirement
// (HTF swing/FVG at the sweep) is not machine-checked — validate that visually.
indicator("TTrades Fractal Model (Recreation)", shorttitle = "TTFM", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ── Inputs ──────────────────────────────────────────────────────────────────
htf          = input.timeframe("60", "Model Timeframe (Candles 1-3)", tooltip = "Chart timeframe is the execution timeframe. Keep the ratio ~4-12x (e.g. 5m chart + 1H model)")
cisdLookback = input.int(20, "CISD Extreme Lookback (chart bars)", minval = 5, maxval = 100, tooltip = "How far back to locate the swept extreme and its delivery series")
showTarget   = input.bool(true, "Show Target (Candle 1 opposite side)")

colBull = color.teal
colBear = color.orange

// ── Confirmed HTF candles: c1 = range candle, c2 = just-closed sweep candle ─
[c1h, c1l] = request.security(syminfo.tickerid, htf, [high[2], low[2]], lookahead = barmerge.lookahead_on)
[c2h, c2l, c2c] = request.security(syminfo.tickerid, htf, [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
newHTF = timeframe.change(htf)

bullC2 = newHTF and c2l < c1l and c2c > c1l and c2c < c1h // swept C1 low, closed back inside
bearC2 = newHTF and c2h > c1h and c2c < c1h and c2c > c1l and not bullC2

// ── CISD machinery ──────────────────────────────────────────────────────────
// Track the open of the current run of consecutive down-closing (and up-closing)
// candles. The CISD level is that series' open at the bar of the extreme.
var float curDownOpen = na
var float curUpOpen   = na
curDownOpen := close < open ? (close[1] < open[1] and not na(curDownOpen) ? curDownOpen : open) : na
curUpOpen   := close > open ? (close[1] > open[1] and not na(curUpOpen)   ? curUpOpen   : open) : na

lowOff  = -ta.lowestbars(low, cisdLookback)   // bars back to the recent extreme low
highOff = -ta.highestbars(high, cisdLookback) // bars back to the recent extreme high

// ── Setup state (armed during candle 3) ─────────────────────────────────────
var int   bias      = 0   // 1 = long setup armed, -1 = short setup armed
var float extreme   = na  // swept wick — close beyond it invalidates
var float cisdLevel = na
var float target    = na

if newHTF
    if bullC2
        bias      := 1
        extreme   := low[lowOff]
        cisdLevel := nz(curDownOpen[lowOff], open[lowOff])
        target    := c1h
    else if bearC2
        bias      := -1
        extreme   := high[highOff]
        cisdLevel := nz(curUpOpen[highOff], open[highOff])
        target    := c1l
    else
        bias := 0 // no reversal closure on the HTF candle → no model this cycle

// If candle 3 makes a deeper extreme first, re-anchor the CISD to the new series
if bias == 1 and low < extreme
    extreme   := low
    cisdLevel := nz(curDownOpen, open)
if bias == -1 and high > extreme
    extreme   := high
    cisdLevel := nz(curUpOpen, open)

// ── CISD confirmation = entry ───────────────────────────────────────────────
longEntry  = bias == 1  and close > cisdLevel
shortEntry = bias == -1 and close < cisdLevel

if longEntry
    line.new(bar_index - 5, cisdLevel, bar_index, cisdLevel, color = color.new(colBull, 0), width = 2)
    label.new(bar_index, cisdLevel, "CISD ▲", style = label.style_label_up, color = color.new(colBull, 80), textcolor = color.white, size = size.small)
    if showTarget
        line.new(bar_index, target, bar_index + 20, target, color = color.new(colBull, 40), style = line.style_dashed)
        label.new(bar_index + 20, target, "T: C1 high", style = label.style_label_left, color = color.new(color.gray, 85), textcolor = color.white, size = size.tiny)
    bias := 0
if shortEntry
    line.new(bar_index - 5, cisdLevel, bar_index, cisdLevel, color = color.new(colBear, 0), width = 2)
    label.new(bar_index, cisdLevel, "CISD ▼", style = label.style_label_down, color = color.new(colBear, 80), textcolor = color.white, size = size.small)
    if showTarget
        line.new(bar_index, target, bar_index + 20, target, color = color.new(colBear, 40), style = line.style_dashed)
        label.new(bar_index + 20, target, "T: C1 low", style = label.style_label_left, color = color.new(color.gray, 85), textcolor = color.white, size = size.tiny)
    bias := 0

// Invalidation: close beyond the swept wick before CISD confirms
invalidated = bias == 1 and close < extreme or bias == -1 and close > extreme
if invalidated
    bias := 0

// ── Markers & alerts ────────────────────────────────────────────────────────
plotshape(bullC2, "Candle 2 Reversal Closure (Bull)", shape.circle, location.belowbar, color.new(colBull, 40), size = size.tiny)
plotshape(bearC2, "Candle 2 Reversal Closure (Bear)", shape.circle, location.abovebar, color.new(colBear, 40), size = size.tiny)
plotshape(longEntry,  "TTFM Long Entry",  shape.triangleup,   location.belowbar, color.new(colBull, 0), size = size.small)
plotshape(shortEntry, "TTFM Short Entry", shape.triangledown, location.abovebar, color.new(colBear, 0), size = size.small)

alertcondition(bullC2, "Candle 2 Bullish Closure", "TTFM: bullish C2 reversal closure on {{ticker}} — awaiting LTF CISD")
alertcondition(bearC2, "Candle 2 Bearish Closure", "TTFM: bearish C2 reversal closure on {{ticker}} — awaiting LTF CISD")
alertcondition(longEntry,  "TTFM Long (CISD)",  "TTFM: bullish CISD confirmed on {{ticker}} ({{interval}}) — targeting Candle 1 high")
alertcondition(shortEntry, "TTFM Short (CISD)", "TTFM: bearish CISD confirmed on {{ticker}} ({{interval}}) — targeting Candle 1 low")
