//@version=6
// Key Intraday Levels
// The "all my key levels in one place" indicator — the exact build that went
// viral as a Claude use case. Plots previous day high/low/close, today's open,
// the opening range, and session VWAP on intraday charts.
indicator("Key Intraday Levels", shorttitle = "Key Levels", overlay = true)

// ── Inputs ──────────────────────────────────────────────────────────────────
showPDH  = input.bool(true, "Previous Day High",  group = "Previous Day")
showPDL  = input.bool(true, "Previous Day Low",   group = "Previous Day")
showPDC  = input.bool(true, "Previous Day Close", group = "Previous Day")

showOpen = input.bool(true, "Today's Open", group = "Today")
showVwap = input.bool(true, "Session VWAP", group = "Today")

showOR    = input.bool(true, "Opening Range", group = "Opening Range")
orSession = input.session("0930-1000", "Opening Range Session", group = "Opening Range", tooltip = "First N minutes of the regular session, in the exchange timezone")

showLabels = input.bool(true, "Show Level Labels", group = "Display")

// ── Previous day levels (daily data, shifted one bar back = no repaint) ─────
[pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)

// ── Today's open ────────────────────────────────────────────────────────────
newDay = timeframe.change("D")
var float dayOpen = na
if newDay
    dayOpen := open

// ── Opening range ───────────────────────────────────────────────────────────
inOR = not na(time(timeframe.period, orSession, syminfo.timezone))
var float orHigh = na
var float orLow  = na
if inOR and not inOR[1]
    orHigh := high
    orLow  := low
else if inOR
    orHigh := math.max(orHigh, high)
    orLow  := math.min(orLow, low)
orDone = not inOR and not na(orHigh)

// ── Session VWAP ────────────────────────────────────────────────────────────
vwapVal = ta.vwap(hlc3)

// ── Plots (intraday only) ───────────────────────────────────────────────────
intraday = timeframe.isintraday

plot(intraday and showPDH ? pdh : na, "Prev Day High",  color = color.new(color.teal, 0),   style = plot.style_linebr, linewidth = 2)
plot(intraday and showPDL ? pdl : na, "Prev Day Low",   color = color.new(color.orange, 0), style = plot.style_linebr, linewidth = 2)
plot(intraday and showPDC ? pdc : na, "Prev Day Close", color = color.new(color.gray, 0),   style = plot.style_linebr, linewidth = 1)
plot(intraday and showOpen ? dayOpen : na, "Today's Open", color = color.new(color.blue, 0), style = plot.style_linebr, linewidth = 1)
plot(intraday and showVwap ? vwapVal : na, "Session VWAP", color = color.new(color.purple, 0), linewidth = 2)

pORH = plot(intraday and showOR and orDone ? orHigh : na, "OR High", color = color.new(color.teal, 40),   style = plot.style_linebr)
pORL = plot(intraday and showOR and orDone ? orLow  : na, "OR Low",  color = color.new(color.orange, 40), style = plot.style_linebr)
fill(pORH, pORL, color = color.new(color.gray, 92), title = "Opening Range Zone")

// ── Right-edge labels ───────────────────────────────────────────────────────
f_label(bool show, float lvl, string txt, color col) =>
    var label lb = na
    if show and intraday and barstate.islast and not na(lvl)
        label.delete(lb)
        lb := label.new(bar_index + 3, lvl, txt, style = label.style_label_left, color = color.new(col, 70), textcolor = color.white, size = size.small)

f_label(showLabels and showPDH, pdh, "PDH", color.teal)
f_label(showLabels and showPDL, pdl, "PDL", color.orange)
f_label(showLabels and showPDC, pdc, "PDC", color.gray)
f_label(showLabels and showOpen, dayOpen, "Open", color.blue)
f_label(showLabels and showVwap, vwapVal, "VWAP", color.purple)
f_label(showLabels and showOR and orDone, orHigh, "ORH", color.teal)
f_label(showLabels and showOR and orDone, orLow, "ORL", color.orange)

// ── Alerts on level breaks ──────────────────────────────────────────────────
alertcondition(ta.crossover(close, pdh),  "Break Above Prev Day High", "{{ticker}} broke above previous day high")
alertcondition(ta.crossunder(close, pdl), "Break Below Prev Day Low",  "{{ticker}} broke below previous day low")
alertcondition(orDone and ta.crossover(close, orHigh),  "Break Above Opening Range", "{{ticker}} broke above the opening range high")
alertcondition(orDone and ta.crossunder(close, orLow),  "Break Below Opening Range", "{{ticker}} broke below the opening range low")
