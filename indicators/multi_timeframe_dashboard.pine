//@version=6
// Multi-Timeframe Trend Dashboard
// One of the most-requested Claude builds: a table in the chart corner showing
// trend direction, RSI, and MACD momentum across five timeframes at a glance,
// plus a confluence score row.
indicator("Multi-Timeframe Trend Dashboard", shorttitle = "MTF Dash", overlay = true)

// ── Inputs ──────────────────────────────────────────────────────────────────
tf1 = input.timeframe("5",   "Timeframe 1", group = "Timeframes")
tf2 = input.timeframe("15",  "Timeframe 2", group = "Timeframes")
tf3 = input.timeframe("60",  "Timeframe 3", group = "Timeframes")
tf4 = input.timeframe("240", "Timeframe 4", group = "Timeframes")
tf5 = input.timeframe("D",   "Timeframe 5", group = "Timeframes")

emaLen = input.int(50, "Trend EMA Length", minval = 1, group = "Signals")
rsiLen = input.int(14, "RSI Length",       minval = 1, group = "Signals")

tablePos = input.string("Top Right", "Dashboard Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = "Display")
textSize = input.string("Small", "Text Size", options = ["Tiny", "Small", "Normal"], group = "Display")

// ── Per-timeframe signal bundle ─────────────────────────────────────────────
f_signals() =>
    trendUp = close > ta.ema(close, emaLen)
    rsiVal  = ta.rsi(close, rsiLen)
    [macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
    macdUp = macdLine > signalLine
    [trendUp, rsiVal, macdUp]

[t1, r1, m1] = request.security(syminfo.tickerid, tf1, f_signals(), lookahead = barmerge.lookahead_off)
[t2, r2, m2] = request.security(syminfo.tickerid, tf2, f_signals(), lookahead = barmerge.lookahead_off)
[t3, r3, m3] = request.security(syminfo.tickerid, tf3, f_signals(), lookahead = barmerge.lookahead_off)
[t4, r4, m4] = request.security(syminfo.tickerid, tf4, f_signals(), lookahead = barmerge.lookahead_off)
[t5, r5, m5] = request.security(syminfo.tickerid, tf5, f_signals(), lookahead = barmerge.lookahead_off)

// ── Table rendering ─────────────────────────────────────────────────────────
colBull    = color.new(color.teal, 20)
colBear    = color.new(color.orange, 20)
colNeutral = color.new(color.gray, 40)
colHeader  = color.new(color.gray, 70)
colText    = color.white

posOpt  = tablePos == "Top Right" ? position.top_right : tablePos == "Top Left" ? position.top_left : tablePos == "Bottom Right" ? position.bottom_right : position.bottom_left
sizeOpt = textSize == "Tiny" ? size.tiny : textSize == "Small" ? size.small : size.normal

var table dash = table.new(posOpt, 5, 7, border_width = 1, border_color = color.new(color.black, 70))

f_row(int row, string tfLabel, bool trendUp, float rsiVal, bool macdUp) =>
    rsiCol = rsiVal >= 70 ? colBear : rsiVal <= 30 ? colBull : colNeutral
    table.cell(dash, 0, row, tfLabel,                    text_color = colText, text_size = sizeOpt, bgcolor = colHeader)
    table.cell(dash, 1, row, trendUp ? "UP" : "DOWN",    text_color = colText, text_size = sizeOpt, bgcolor = trendUp ? colBull : colBear)
    table.cell(dash, 2, row, str.tostring(rsiVal, "#.0"),text_color = colText, text_size = sizeOpt, bgcolor = rsiCol)
    table.cell(dash, 3, row, macdUp ? "BULL" : "BEAR",   text_color = colText, text_size = sizeOpt, bgcolor = macdUp ? colBull : colBear)
    score = (trendUp ? 1 : 0) + (macdUp ? 1 : 0) + (rsiVal > 50 ? 1 : 0)
    table.cell(dash, 4, row, str.tostring(score) + "/3", text_color = colText, text_size = sizeOpt, bgcolor = score >= 2 ? colBull : score <= 1 ? colBear : colNeutral)
    score

if barstate.islast
    // Header row
    table.cell(dash, 0, 0, "TF",    text_color = colText, text_size = sizeOpt, bgcolor = colHeader)
    table.cell(dash, 1, 0, "Trend", text_color = colText, text_size = sizeOpt, bgcolor = colHeader)
    table.cell(dash, 2, 0, "RSI",   text_color = colText, text_size = sizeOpt, bgcolor = colHeader)
    table.cell(dash, 3, 0, "MACD",  text_color = colText, text_size = sizeOpt, bgcolor = colHeader)
    table.cell(dash, 4, 0, "Score", text_color = colText, text_size = sizeOpt, bgcolor = colHeader)

    s1 = f_row(1, tf1, t1, r1, m1)
    s2 = f_row(2, tf2, t2, r2, m2)
    s3 = f_row(3, tf3, t3, r3, m3)
    s4 = f_row(4, tf4, t4, r4, m4)
    s5 = f_row(5, tf5, t5, r5, m5)

    // Confluence summary row
    total = s1 + s2 + s3 + s4 + s5
    verdict = total >= 11 ? "STRONG BULL" : total >= 8 ? "LEAN BULL" : total <= 4 ? "STRONG BEAR" : "LEAN BEAR"
    verdictCol = total >= 8 ? colBull : colBear
    table.merge_cells(dash, 0, 6, 3, 6)
    table.cell(dash, 0, 6, "Confluence: " + verdict, text_color = colText, text_size = sizeOpt, bgcolor = verdictCol)
    table.cell(dash, 4, 6, str.tostring(total) + "/15", text_color = colText, text_size = sizeOpt, bgcolor = verdictCol)
